# PostgreSQL connection string (see research.md, п.3)
DATABASE_URL="postgresql://user:password@localhost:5432/petproj?schema=public"

# Auth.js (see research.md, п.4)
NEXTAUTH_SECRET="generate-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3010"
RATE_LIMIT_SECRET="generate-a-second-random-32-byte-secret"

# Telegram-бот (deep link t.me/<bot>?start=<token>) — єдиний спосіб входу/реєстрації.
# Бот створюється через @BotFather. Вхід підтверджується реальним webhook-апдейтом
# (TELEGRAM_BOT_UPDATE_SECRET нижче) — тому не працює без публічного домену з HTTPS
# (або через ngrok для тесту) і без `npm run telegram:set-webhook`.
TELEGRAM_BOT_TOKEN=""
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""

# HMAC-секрет для проверки подписи POS-webhook (specs/002-member-gold-system).
# До реальной интеграции с SkyService используется только с fake-провайдером в dev/тестах.
POS_WEBHOOK_SECRET="generate-a-third-random-32-byte-secret"

# HMAC-секрет для webhook подтверждения контакта Telegram-бота (specs/002-member-gold-system,
# Промт 6). До появления реального бота используется только с fake-транспортом в тестах.
TELEGRAM_BOT_WEBHOOK_SECRET="generate-a-fourth-random-32-byte-secret"

# Секрет для реального webhook апдейтов Telegram Bot API (/api/webhooks/telegram-bot/update).
# Telegram присилає його назад у заголовку X-Telegram-Bot-Api-Secret-Token — задайте один раз
# через `npm run telegram:set-webhook` (потребує TELEGRAM_BOT_TOKEN і публічний NEXTAUTH_URL).
TELEGRAM_BOT_UPDATE_SECRET="generate-a-fifth-random-32-byte-secret"
