// Модель данных для фичи specs/001-bar-menu-account (см. data-model.md)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// pg_trgm — нечёткий поиск по 3-граммам (третий уровень в /api/menu/items),
// см. миграцию 20260725140000_menu_item_trigram_search.
datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

// --- Пользователь и связанные с аккаунтом сущности (FR-004…FR-011, FR-017, FR-024, FR-026) ---
// Единственный способ входа — Telegram-бот через deep link (см. lib/telegram-login.ts, FR-004).
// Сессия — JWT в httpOnly cookie (research.md, п.4), без адаптера Prisma и без хранения
// паролей/OAuth-аккаунтов.

// Member / Gold Member (specs/002-member-gold-system): роль вычисляется только сервером
// из подтверждённых POS-чеков (см. lib/roles.ts), понижение Gold -> Member не выполняется.
enum GuestRole {
  MEMBER
  GOLD_MEMBER
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String?   @unique
  emailVerified DateTime?
  phone         String?   @unique
  phoneVerifiedAt DateTime?
  telegramId    String?   @unique
  telegramUsername String?
  isAdmin       Boolean   @default(false)
  role          GuestRole @default(MEMBER)
  goldSinceMonth String?  // "YYYY-MM" месяц присвоения Gold, для аудита правила (FR-007)
  telegramBotLinkedAt DateTime? // FR-027: отвязка сбрасывает это поле в null
  createdAt     DateTime  @default(now())

  receipts           Receipt[]
  bonusTransactions  BonusTransaction[]
  menuItemLikes      MenuItemLike[]
  tableSessions      TableSession[]        @relation("TableSessionGuest")
  confirmedSessions  TableSession[]        @relation("TableSessionConfirmedBy")
  telegramBotLinkTokens TelegramBotLinkToken[]
  auditLogEntries    AuditLogEntry[]
  serviceRequests        ServiceRequest[] @relation("ServiceRequestGuest")
  handledServiceRequests ServiceRequest[] @relation("ServiceRequestHandledBy")
  reviews                Review[]

  @@index([role])
}

// Persistent counters for public endpoints. They work across Next.js instances
// and must never contain raw email addresses or phone numbers.
model RateLimit {
  key             String   @id
  count           Int      @default(0)
  windowStartedAt DateTime
  updatedAt       DateTime @updatedAt
}

// --- Меню (FR-001…FR-003, FR-015, FR-019…FR-022) ---

model MenuCategory {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique
  parentId     String?
  order        Int     @default(0)
  // Id категорії в CastaPOS (lib/menu-sync.ts) — ключ ідемпотентності для sync-вебхука. Null для
  // категорій, не пов'язаних із POS (напр. створених вручну до інтеграції чи через menu:import).
  posExternalId String? @unique

  parent   MenuCategory?  @relation("CategoryToSubcategory", fields: [parentId], references: [id], onDelete: Cascade)
  children MenuCategory[] @relation("CategoryToSubcategory")
  items    MenuItem[]
}

model MenuItem {
  id          String   @id @default(cuid())
  categoryId  String
  name        String
  // Ці три поля CastaPOS не веде (товар/тех.карта там не мають опису/об'єму/ABV) — тепер
  // необов'язкові, щоб позиції, що прийшли через menu-sync (lib/menu-sync.ts), могли лишити їх
  // порожніми замість фейкових значень. Раніше були обов'язковими під ручний menu:import
  // (shaketopay-експорт), який завжди їх заповнював.
  description String   @default("")
  price       Decimal  @db.Decimal(10, 2)
  currency    String   @default("UAH")
  photoUrl    String?
  volume      String   @default("")
  abv         Decimal? @db.Decimal(4, 1)
  // Id товару/тех.карти в CastaPOS — ключ ідемпотентності для sync-вебхука, те саме, що
  // MenuCategory.posExternalId вище.
  posExternalId String? @unique
  // "product" | "recipe" — CastaPOS шле це в кожному menu-sync payload (lib/site-sync.ts там же),
  // тут довго не зберігалося (нема куди й нема навіщо було). Потрібне для гостьового замовлення
  // (GuestOrderRequestItem): коли каса тягне заявку назад, їй треба знати, чи posExternalId —
  // це Product.id чи Recipe.id, щоб додати правильну позицію в чек.
  kind        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category MenuCategory        @relation(fields: [categoryId], references: [id])
  likes    MenuItemLike[]
  orderRequestItems GuestOrderRequestItem[]

  @@unique([categoryId, name])
  @@index([categoryId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin)
}

model MenuItemLike {
  id         String   @id @default(cuid())
  menuItemId String
  visitorId  String
  userId     String?
  createdAt  DateTime @default(now())

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([menuItemId, visitorId])
}

// --- Привязка гостя к столу (specs/002-member-gold-system, FR-003…FR-006, FR-017) ---
// Один гость на активную сессию стола (решено 2026-07-23). Уникальность активной сессии
// на tableCode обеспечена частичным индексом в SQL-миграции (Prisma это не выражает).
enum TableSessionStatus {
  PENDING_STAFF_CONFIRMATION
  CONFIRMED
  REJECTED
  CLOSED
}

model TableSession {
  id                 String              @id @default(cuid())
  tableCode          String
  userId             String
  status             TableSessionStatus  @default(PENDING_STAFF_CONFIRMATION)
  posTableExternalId String?
  requestedAt        DateTime            @default(now())
  confirmedAt        DateTime?
  confirmedByStaffId String?
  closedAt           DateTime?

  user        User      @relation("TableSessionGuest", fields: [userId], references: [id])
  confirmedBy User?     @relation("TableSessionConfirmedBy", fields: [confirmedByStaffId], references: [id])
  receipts    Receipt[]
  orderRequests GuestOrderRequest[]

  @@index([tableCode, status])
  @@index([userId])
}

// --- Гостьове замовлення з сайту (CONFIRMED TableSession) ---
// Каса CastaPOS не приймає вхідних запитів (окремий репозиторій, на залізі бару) — на відміну
// від решти інтеграції (push CastaPOS -> сайт), тут напрямок зворотний: каса сама періодично
// тягне PENDING-заявки через GET /api/pos/guest-order-requests (lib/webhook-security.ts:
// verifySecretToken, той самий секрет POS_WEBHOOK_SECRET) і підтверджує/відхиляє їх назад через
// POST .../resolve. Підтверджені позиції потрапляють у звичайний чек столу на боці каси — тут
// лишається лише історія заявки, не сам чек.
enum GuestOrderRequestStatus {
  PENDING
  IMPORTED
  REJECTED
}

model GuestOrderRequest {
  id             String                  @id @default(cuid())
  tableSessionId String
  status         GuestOrderRequestStatus @default(PENDING)
  createdAt      DateTime                @default(now())
  resolvedAt     DateTime?

  tableSession TableSession            @relation(fields: [tableSessionId], references: [id])
  items        GuestOrderRequestItem[]

  @@index([tableSessionId, status])
}

model GuestOrderRequestItem {
  id        String  @id @default(cuid())
  requestId String
  menuItemId String
  name      String  // знімок назви на момент подачі — MenuItem могли синкнути заново до підтвердження
  price     Decimal @db.Decimal(10, 2)
  quantity  Int
  comment   String?

  request  GuestOrderRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  menuItem MenuItem          @relation(fields: [menuItemId], references: [id])

  @@index([requestId])
}

// --- Послуги для Gold Member (бронювання столу, оренда кальяну) ---
// Доступ лише для GOLD_MEMBER, перевіряється на сервері (аналогічно доступу до Telegram-бота).
enum ServiceRequestType {
  TABLE_BOOKING
  HOOKAH_RENTAL
}

enum ServiceRequestStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model ServiceRequest {
  id               String                @id @default(cuid())
  userId           String
  type             ServiceRequestType
  status           ServiceRequestStatus  @default(PENDING)
  tableCode        String?               // лише для TABLE_BOOKING — обраний вільний стіл
  comment          String?
  requestedAt      DateTime              @default(now())
  handledAt        DateTime?
  handledByStaffId String?

  user      User  @relation("ServiceRequestGuest", fields: [userId], references: [id])
  handledBy User? @relation("ServiceRequestHandledBy", fields: [handledByStaffId], references: [id])

  @@index([userId])
  @@index([status])
}

// --- Дзеркало стану столів CastaPOS (окремий репозиторій, власна незалежна БД — не спільна) ---
// Ці таблиці НЕ спільні з CastaPOS: він живе на власному залізі бару, сюди йому не дотягнутись, і
// у нього своя Postgres. Наповнюються push-вебхуками з CastaPOS (lib/site-sync.ts там же) —
// table-opened/table-closed (app/api/webhooks/pos/*), lib/pos/shared-db-provider.ts тут лише
// читає. Сам чек/бонуси/Gold — все ще виключно через /api/webhooks/pos/receipt (importPosReceipt),
// CastaPOS у Receipt/BonusTransaction не пише.
enum PosOrderStatus {
  OPEN
  CLOSED
  CANCELLED
}

model PosTable {
  id     String     @id @default(cuid())
  code   String     @unique // "1".."10" — ті самі коди, що й TableSession.tableCode
  label  String?
  orders PosOrder[]
}

// Тільки одне відкрите замовлення на стіл одночасно — забезпечено частковим унікальним індексом
// у SQL-міграції (Prisma це не виражає, той самий підхід, що й PosShift нижче та сам CastaPOS —
// PosOrder_single_open_per_table_key там же). Без цього індексу table-opened вебхук
// (app/api/webhooks/pos/table-opened/route.ts) мав би TOCTOU-гонку: два майже одночасні виклики
// (напр. ретрай доставки) обидва пройшли б перевірку "чи є вже відкрите" до того, як хтось
// встиг вставити свій рядок.
model PosOrder {
  id          String         @id @default(cuid())
  tableId     String
  shiftId     String? // зміна, під час якої відкрито стіл (шифти обов'язкові — див. PosShift)
  status      PosOrderStatus @default(OPEN)
  guestUserId String?
  openedAt    DateTime       @default(now())
  closedAt    DateTime?
  receiptId   String?        @unique // legacy 1:1-поле з часів до спліт-чека, більше не заповнюється — джерело істини тепер PosReceiptGroup.receiptId

  table         PosTable          @relation(fields: [tableId], references: [id])
  shift         PosShift?         @relation(fields: [shiftId], references: [id])
  items         PosOrderItem[]
  receiptGroups PosReceiptGroup[]

  @@index([tableId, status])
  @@index([shiftId])
}

model PosOrderItem {
  id             String   @id @default(cuid())
  orderId        String
  menuItemId     String? // null = довільна позиція, не з каталогу MenuItem
  name           String // знімок назви на момент додавання
  price          Decimal  @db.Decimal(10, 2)
  quantity       Int      @default(1)
  addedAt        DateTime @default(now())
  receiptGroupId String? // заповнюється, коли позицію віднесено до конкретного (спліт-)чека

  order        PosOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  receiptGroup PosReceiptGroup? @relation(fields: [receiptGroupId], references: [id])

  @@index([receiptGroupId])
}

// --- Зміни каси, рух готівки, спліт чека (фаза "каса" цільової моделі, див. golden-sparking-emerson.md) ---
// Особистих логінів касирів немає (свідомо поза скоупом) — openedByName/closedByName це вільний текст,
// а не FK на User. Тільки одна відкрита зміна одночасно — забезпечено частковим унікальним індексом
// у SQL-міграції (Prisma це не виражає, той самий підхід, що й для TableSession вище).
enum PosShiftStatus {
  OPEN
  CLOSED
}

model PosShift {
  id           String         @id @default(cuid())
  status       PosShiftStatus @default(OPEN)
  openedByName String?
  openedAt     DateTime       @default(now())
  openingCash  Decimal        @db.Decimal(10, 2)
  closedByName String?
  closedAt     DateTime?
  closingCash  Decimal?       @db.Decimal(10, 2)

  orders           PosOrder[]
  cashTransactions PosCashTransaction[]
  receiptGroups    PosReceiptGroup[]

  @@index([status])
}

enum PosCashTransactionType {
  DEPOSIT // Внесення
  WITHDRAWAL // Інкасація
  EXPENSE // Витрата
}

model PosCashTransaction {
  id        String                 @id @default(cuid())
  shiftId   String
  type      PosCashTransactionType
  amount    Decimal                @db.Decimal(10, 2)
  comment   String?
  createdAt DateTime               @default(now())

  shift PosShift @relation(fields: [shiftId], references: [id])

  @@index([shiftId])
}

// Один "пробитий чек" на боці CastaPOS — може покривати частину позицій PosOrder (спліт).
// posExternalId — те, що йде у вебхук до /api/webhooks/pos/receipt; receiptId — id вже
// створеного там Receipt (null, доки вебхук не відповів успішно).
model PosReceiptGroup {
  id            String             @id @default(cuid())
  orderId       String
  shiftId       String
  paymentType   ReceiptPaymentType
  totalAmount   Decimal            @db.Decimal(10, 2)
  posExternalId String             @unique
  receiptId     String?            @unique
  createdAt     DateTime           @default(now())

  order PosOrder       @relation(fields: [orderId], references: [id])
  shift PosShift       @relation(fields: [shiftId], references: [id])
  items PosOrderItem[]

  @@index([orderId])
  @@index([shiftId])
}

// --- Чеки и бонусы (FR-007, FR-009, FR-010, FR-011, FR-016, FR-025; specs/002 FR-007…FR-017) ---

enum ReceiptSource {
  MANUAL_ADMIN
  POS_IMPORT
}

enum ReceiptStatus {
  CONFIRMED
  REFUNDED
  CANCELLED
}

// Готівка/картка — введено разом зі змінами каси CastaPOS (PosShift/PosCashTransaction/
// PosReceiptGroup вище). MANUAL_ADMIN-чеки (admin/receipts/new) не мають способу оплати
// в UI — лишаються на дефолтному CASH.
enum ReceiptPaymentType {
  CASH
  CARD
}

model Receipt {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime
  totalAmount Decimal  @db.Decimal(10, 2)
  currency    String   @default("UAH")
  createdAt   DateTime @default(now())

  source                ReceiptSource      @default(MANUAL_ADMIN)
  status                ReceiptStatus      @default(CONFIRMED)
  paymentType           ReceiptPaymentType @default(CASH)
  posExternalId         String?            @unique
  tableSessionId        String?
  countsTowardGoldMonth String?

  user              User               @relation(fields: [userId], references: [id])
  tableSession      TableSession?      @relation(fields: [tableSessionId], references: [id])
  items             ReceiptItem[]
  bonusTransactions BonusTransaction[]

  @@index([userId])
  @@index([date])
  @@index([tableSessionId])
}

model ReceiptItem {
  id        String  @id @default(cuid())
  receiptId String
  name      String
  price     Decimal @db.Decimal(10, 2)
  quantity  Int     @default(1)

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
}

model BonusTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Decimal  @db.Decimal(10, 2)
  reason    String
  type      String   @default("ACCRUAL") // "ACCRUAL" | "REVERSAL" (specs/002 FR-008)
  receiptId String?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id])
  receipt Receipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@unique([receiptId, type])
}

// --- Telegram-бот для Gold Member (specs/002-member-gold-system FR-010…FR-012) ---
// Сырой токен deep link никогда не хранится — только его SHA-256 хеш (см. lib/telegram-bot-link.ts
// для аналогичной техники). Номер телефона в этой таблице не хранится.
model TelegramBotLinkToken {
  id             String    @id @default(cuid())
  userId         String
  tokenHash      String    @unique
  telegramChatId String?   // Привязывается на /start, пока не подтверждён контакт (мост между апдейтами бота)
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([telegramChatId])
}

// --- Вход через Telegram-бота (замена Login Widget, FR-004) ---
// Гість тисне "Увійти" → отримує одноразовий токен і t.me/<bot>?start=<token>, це відкриває
// саме застосунок Telegram (а не веб-версію, як робив oauth-попап Login Widget). Апдейт
// `/start <token>` вже містить telegram id/ім'я — окремого запиту контакту, як для Gold-бота,
// не потрібно. Сирий токен не зберігається — тільки його SHA-256 хеш.
model TelegramLoginToken {
  id               String    @id @default(cuid())
  tokenHash        String    @unique
  telegramUserId   String?
  telegramUsername String?
  firstName        String?
  lastName         String?
  confirmedAt      DateTime?
  consumedAt       DateTime?
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
}

// --- Audit log (specs/002-member-gold-system) ---
// Не хранить: телефоны, токены, тела подписей webhook — только идентификаторы и факты.
enum AuditAction {
  ROLE_CHANGED
  PHONE_VERIFIED
  TABLE_SESSION_CONFIRMED
  TABLE_SESSION_REJECTED
  CASHBACK_REVERSED
  BOT_LINKED
  BOT_UNLINKED
  SERVICE_REQUEST_CONFIRMED
  SERVICE_REQUEST_REJECTED
}

model AuditLogEntry {
  id           String      @id @default(cuid())
  action       AuditAction
  targetUserId String
  actor        String
  metadata     Json?
  createdAt    DateTime    @default(now())

  targetUser User @relation(fields: [targetUserId], references: [id])

  @@index([targetUserId])
  @@index([action])
}

// Настраиваемая ставка начисления бонусов (админ-инструмент, см. spec.md).
// Singleton-запись: одна строка с id = "default".
model BonusSettings {
  id         String  @id @default("default")
  percentage Decimal @db.Decimal(5, 2) // например, 3.00 = 3% от суммы чека
}

// --- Акции (FR-008) ---

model PromoBanner {
  id          String   @id @default(cuid())
  // Раніше обов'язкове — зараз керується з CastaPOS (app/api/webhooks/pos/promo-banners), де
  // фото не завжди задане одразу; текстовий банер без картинки лишається робочим варіантом
  // (components/PromoCarousel.tsx фолбечиться на теперішній текст+дим-текстуру вигляд).
  imageUrl    String?
  title       String
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // Id банера в CastaPOS — ключ ідемпотентності, той самий підхід, що MenuItem.posExternalId.
  posExternalId String? @unique
}

// --- Контакты / о заведении (FR-012…FR-014, FR-022, FR-023) ---
// Singleton-запись: одна строка с id = "default".

model SiteContent {
  id                 String @id @default("default")
  address            String
  addressMapUrl      String
  mapEmbedUrl        String
  workingHours       String
  phone              String
  instagramUrl       String?
  googleUrl          String?
  facebookUrl        String?
  allergyDisclaimer  String
  aboutText          String
  // Брендинг — приходить з CastaPOS (app/api/webhooks/pos/site-content), джерело правди там
  // (AppSettings). Null, поки власник ще не зберіг ці поля в адмінці CastaPOS — фронт (SiteHeader,
  // головна, app/layout.tsx) фолбечиться на статичні public/logo.svg, public/hero-bar.jpg й
  // захардкожені рядки, тож сайт лишається робочим і до першої синхронізації.
  venueName  String?
  tagline    String?
  logoUrl    String?
  faviconUrl String?
  heroImageUrl String?
  telegramUrl  String?

  // Акцентний колір теми (hex) — lib/color.ts виводить з нього bright/muted/contrast відтінки,
  // застосовується інлайн-стилем на <html> в app/layout.tsx. Null = дефолтна палітра з
  // app/globals.css.
  accentColor String?

  // Розклад по днях тижня — заступає workingHours (вище) в SiteFooter, коли заданий; форма
  // { mon: {open,close}|null, ..., sun } — null означає вихідний, ключ відсутній/null поле
  // означає "власник ще не переходив на новий формат", тоді фронт бере старий workingHours.
  workingHoursByDay Json?

  // Текст юридичних сторінок — приходить з CastaPOS (власник сам пише), null = відповідна
  // сторінка/посилання в футері не показується взагалі (app/(public)/privacy-policy/тощо).
  privacyPolicyText String?
  termsOfUseText    String?
  cookiePolicyText  String?

  // Кнопка "Замовити" на /account/table (GuestOrderRequest нижче) — приходить з CastaPOS
  // AppSettings.guestOrderingEnabled. Null/false — гість лише переглядає меню, як зараз.
  guestOrderingEnabled Boolean?
}

// Відгук гостя (FR: форма "Залишити відгук") — на відміну від решти сайт-контенту, НЕ приходить
// з CastaPOS: гість лишає його прямо на сайті (app/(public)/feedback), CastaPOS ніколи не бачить
// (не приймає вхідних запитів ззовні — весь інший синк іде в протилежний бік). Перегляд —
// у власній адмінці PetProj (app/(admin)/admin/reviews), не в CastaPOS.
model Review {
  id            String   @id @default(cuid())
  dishesRating  Int // 1..5
  serviceRating Int // 1..5
  comment       String?
  contactName   String?
  contactPhone  String?
  userId        String? // якщо гість був залогінений на момент подачі
  createdAt     DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}
